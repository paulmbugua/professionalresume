FROM node:22-bookworm-slim AS builder

WORKDIR /workspace
RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml tsconfig.base.json tsconfig.json ./
COPY .yarn/releases .yarn/releases
COPY apps/admin/package.json apps/admin/package.json
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN yarn install --immutable

COPY apps/admin ./apps/admin
COPY packages/shared ./packages/shared

ARG VITE_BACKEND_URL=https://server.professionalresume.co.ke
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

RUN yarn workspace @cvpro/admin build

FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
COPY deploy/hostpinnacle/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/admin/dist /usr/share/nginx/html
