FROM node:22-bookworm-slim AS dependencies

WORKDIR /workspace
RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases .yarn/releases
COPY apps/admin/package.json apps/admin/package.json
COPY apps/backend/package.json apps/backend/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json

# PDF export dynamically imports Puppeteer and Playwright, which currently live
# in the backend workspace's devDependencies. Keep that workspace's complete
# dependency set in the runtime image until those packages are reclassified.
RUN yarn workspaces focus @cvpro/backend

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=4006 \
    CHROME_PATH=/usr/bin/chromium \
    PUPPETEER_SKIP_DOWNLOAD=true
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash ca-certificates chromium curl fontconfig fonts-dejavu-core \
      fonts-liberation gosu tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dependencies /workspace/node_modules ./node_modules
COPY --from=dependencies /workspace/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=dependencies /workspace/package.json ./package.json
COPY --from=dependencies /workspace/apps/backend/package.json ./apps/backend/package.json
COPY apps/backend ./apps/backend
COPY packages/shared ./packages/shared
COPY deploy/hostpinnacle/scripts/backend-entrypoint.sh /usr/local/bin/professionalresume-backend-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/professionalresume-backend-entrypoint \
    && chmod 0755 /usr/local/bin/professionalresume-backend-entrypoint

WORKDIR /workspace/apps/backend
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/professionalresume-backend-entrypoint"]
